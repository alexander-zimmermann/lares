{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "github>alexander-zimmermann/lares//.renovate/autoMerge.json5",
    "github>alexander-zimmermann/lares//.renovate/customManagers.json5",
    "github>alexander-zimmermann/lares//.renovate/grafanaDashboards.json5",
    "github>alexander-zimmermann/lares//.renovate/groups.json5",
    "github>alexander-zimmermann/lares//.renovate/labels.json5",
    "github>alexander-zimmermann/lares//.renovate/releaseNotes.json5",
    "github>alexander-zimmermann/lares//.renovate/semanticCommits.json5",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":gitSignOff",
    ":semanticCommits",
    ":timezone(Europe/Berlin)"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "dependencyDashboardLabels": ["area/renovate"],
  "suppressNotifications": ["prEditedNotification", "prIgnoreNotification"],
  "ignorePaths": ["**/resources/**", "**/deprecated/**"],
  "ignoreDeps": ["alexellis/arkade-get"],
  "kubernetes": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "flux": {
    "managerFilePatterns": ["/\\.yaml$/"]
  },
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      // Hermes churns weekly, its config schema with it; every bump is reviewed against the generated config.
      // Tags are the Hermes release plus a build count for our patch set, e.g. v0.22.6-lares.2.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/alexander-zimmermann/hermes-agent-patched"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-lares\\.(?<build>\\d+)$",
      "automerge": false
    },
    {
      // Tags are PostgreSQL plus TimescaleDB, e.g. 18.6-ts2.26-tk; docker versioning would drop the TimescaleDB part.
      // With the whole tag as the version, TimescaleDB bumps show up and match the release tags.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/alexander-zimmermann/cnpg-postgres-timescaledb"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-ts(?<patch>\\d+)\\.(?<build>\\d+)-tk$"
    }
  ]
}
