# Local inputs of the KNX and Basalte tasks (task knx:*, task basalte:*).
# Copy to .env — git-ignored — and fill in. Each file is a foreign system's
# own configuration, the source of truth for what that system does on the
# KNX bus; the tasks read them, nothing here is deployed. Re-export and
# overwrite in place whenever the system's configuration changed; a task
# whose input is missing names the key. Paths are absolute or relative to
# the repository root (exports/ under the root is git-ignored, if you want
# to keep them there).

# ETS: the project export (.knxproj, password-protected) — names, DPTs and
# what is installed on the bus.
KNX_PROJECT_PATH=/path/to/project.knxproj

# A file holding the password of that ETS project (one line, mode 600),
# outside the repository. The tasks read it into the environment of the
# knxproj tools only for the command that needs it, so `task --summary`
# and the command echo show this path, never the password.
KNXPROJ_PASSWORD_FILE=/home/you/.config/lares/knxproj-password

# Basalte Studio: the project export (.bcfg) — the bindings Basalte wires
# to the bus.
BASALTE_EXPORT_PATH=/path/to/project.bcfg

# Node-Red: menu → Export → all flows (.json) — the addresses the flows touch.
NODE_RED_FLOWS_PATH=/path/to/flows.json

# Telenot compasX: the CSV export of the KNX interface — what the panel
# sends (KNX_Status) and what it acts on (KNX_Switch).
TELENOT_EXPORT_PATH=/path/to/ExportCSV_TELENOT_Interface_KNX_400_IP.csv
